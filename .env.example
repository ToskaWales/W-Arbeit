# Nur serverseitig verwenden. Echte Werte in .env.local (wird nie committet).
ANTHROPIC_API_KEY=
# Mindestens 12 Zeichen, sonst bleibt /admin gesperrt.
ADMIN_PASSWORD=
# Upstash Redis (Vercel Marketplace legt diese Variablen automatisch an)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Schlüssel zum Verschlüsseln der gespeicherten Seminararbeiten (Pflicht, sonst ist das Speichern gesperrt).
# Erzeugen mit: openssl rand -base64 32   Achtung: Geht der Schlüssel verloren, sind alle gespeicherten Arbeiten unlesbar.
WORK_ENCRYPTION_KEY=

# Betreiberangaben für Impressum und Datenschutzerklärung (Pflicht vor dem Go-live, prüfen mit: npm run check:legal)
LEGAL_NAME=
# Anschrift, Zeilen mit | trennen, z. B. Musterstraße 1|80331 München
LEGAL_ADDRESS=
LEGAL_EMAIL=
# freiwillig
LEGAL_PHONE=
# Region der Upstash-Datenbank, z. B. Frankfurt (eu-central-1)
UPSTASH_REGION=
